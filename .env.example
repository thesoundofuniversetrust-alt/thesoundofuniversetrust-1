# =====================================================
#  TSU Website – Netlify Environment Variables
#  Copy this to .env for local dev (never commit .env)
#  Set these in: Netlify Dashboard → Site → Environment variables
# =====================================================

# ---- Owner credentials ----
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=YourSecurePasswordHere

# ---- Security secrets (generate random strings, min 32 chars) ----
OTP_SECRET=replace-with-random-32-char-string
SESSION_SECRET=replace-with-another-random-32-char-string

# ---- Email (Resend.com – free tier: 3000 emails/month) ----
# Sign up at https://resend.com  →  API Keys  →  Create key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=TSU Dashboard <noreply@yourdomain.com>

# ---- Cloudinary (free tier: 25GB storage, 25GB bandwidth/month) ----
# Sign up at https://cloudinary.com  →  Dashboard  →  API Keys
CLOUDINARY_CLOUD_NAME=hysi8ysy
CLOUDINARY_API_KEY=799642663225128
CLOUDINARY_API_SECRET=your-api-secret-here
