# =====================================================
#  TSU Website – Netlify Environment Variables
#  Copy this to .env for local dev (never commit .env)
#  Set the real values in:
#  Netlify Dashboard → Site → Environment variables
# =====================================================

OWNER_EMAIL=your-owner-email@gmail.com
OWNER_PASSWORD=your-secure-password
OTP_SECRET=replace-with-random-32-char-string
SESSION_SECRET=replace-with-another-random-32-char-string
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=onboarding@resend.dev
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
